# Copia este archivo a .env y pon tu key vigente.
# Consíguela en https://aistudio.google.com/apikey
# La key vive SOLO aquí (.env está en .gitignore; nunca se commitea ni va
# a la config global de ZCode).
GEMINI_API_KEY=

# Opcional: modelo de Gemini (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
